# 访问口令（强烈建议在公网部署时设置；留空则免密访问）
ACCESS_PASSWORD=

# 会话签名密钥（留空时启动自动生成随机密钥；建议公网部署时固定一个随机字符串）
AUTH_SECRET=

# 可选代理地址，例如 http://127.0.0.1:7890 或 socks5://127.0.0.1:10808（海外云平台部署通常无需填写）
JM_PROXY=

# 客户端模式：api（默认，推荐）或 html
JM_CLIENT_IMPL=api

# 临时图片缓存最大占用（MB），超出后自动按 LRU 清理
CACHE_MAX_MB=120

# 后端并发线程池大小
JM_WORKERS=6

# 服务监听端口（Render / Hugging Face Spaces 会自动注入 PORT，Hugging Face 默认 7860）
PORT=7860
